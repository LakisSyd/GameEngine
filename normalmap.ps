////////////////////////////////////////////////////////////////////////////////
// Имя файла: normalmap.ps
////////////////////////////////////////////////////////////////////////////////
/////////////
// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ //
/////////////
Texture2D shaderTexture1 : register(t0);  // Базовая цветовая текстура
Texture2D shaderTexture2 : register(t1);  // Карта нормалей
SamplerState SampleType : register(s0);

cbuffer LightBuffer
{
    float4 diffuseColor;   // Цвет рассеянного света
    float3 lightDirection; // Направление света
    float padding;         // Выравнивание буфера
};

//////////////
// ОПРЕДЕЛЕНИЯ ТИПОВ //
//////////////
struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
    float3 normal : NORMAL;
    float3 tangent : TANGENT;
    float3 binormal : BINORMAL;
};

////////////////////////////////////////////////////////////////////////////////
// Пиксельный шейдер //
////////////////////////////////////////////////////////////////////////////////
float4 NormalMapPixelShader(PixelInputType input) : SV_TARGET
{
    float4 textureColor;   // Цвет из базовой текстуры
    float4 bumpMap;        // Значение из карты нормалей
    float3 bumpNormal;     // Вычисленная нормаль бампа
    float3 lightDir;       // Направление света (инвертированное)
    float lightIntensity;  // Интенсивность освещения
    float4 color;          // Финальный цвет пикселя
    
    // Сэмплируем цвет из базовой текстуры
    textureColor = shaderTexture1.Sample(SampleType, input.tex);
    
    // Сэмплируем значение из карты нормалей
    bumpMap = shaderTexture2.Sample(SampleType, input.tex);
    
    // Преобразуем диапазон нормалей из [0, +1] в [-1, +1]
    // Это необходимо, так как текстуры хранят значения только в [0, 1]
    bumpMap = (bumpMap * 2.0f) - 1.0f;
    
    // Вычисляем нормаль бампа по формуле:
    // bumpNormal = N.x * tangent + N.y * binormal + N.z * normal
    bumpNormal = (bumpMap.x * input.tangent) + 
                 (bumpMap.y * input.binormal) + 
                 (bumpMap.z * input.normal);
    
    // Нормализуем полученную нормаль
    bumpNormal = normalize(bumpNormal);
    
    // Инвертируем направление света для расчётов
    lightDir = -lightDirection;
    
    // Вычисляем интенсивность света через скалярное произведение
    // saturate ограничивает результат диапазоном [0, 1]
    lightIntensity = saturate(dot(bumpNormal, lightDir));
    
    // Вычисляем финальный рассеянный цвет
    color = saturate(diffuseColor * lightIntensity);
    
    // Комбинируем с цветом текстуры
    color = color * textureColor;
    
    return color;
}