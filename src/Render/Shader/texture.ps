////////////////////////////////////////////////////////////////////////////////
// Filename: texture.ps
////////////////////////////////////////////////////////////////////////////////
// Имя файла: texture.ps

/////////////
// GLOBALS //
/////////////
// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ
// У пиксельного шейдера текстур есть две глобальные переменные. 
// Первая — Texture2D shaderTexture, это ресурс текстуры. 
// Это будет наш ресурс текстуры, который будет использоваться для рендеринга текстуры на модели.
// Вторая новая переменная — SamplerState SampleType. 
// Состояние сэмплера позволяет нам изменять способ записи пикселей на грань полигона при затенении. 
// Например, если полигон находится очень далеко и занимает всего 8 пикселей на экране, 
// мы используем состояние сэмплера, чтобы выяснить, какие пиксели или какая комбинация пикселей 
// будет фактически нарисована из оригинальной текстуры. 
// Оригинальная текстура может быть 256x256 пикселей, поэтому решение того, какие пиксели рисовать, 
// действительно важно, чтобы текстура все еще выглядела достойно на очень маленькой грани полигона. 
// Мы настроим состояние сэмплера в TextureShaderClass, а затем прикрепим его к указателю ресурса, 
// чтобы этот пиксельный шейдер мог использовать его для определения того, какой образец пикселей рисовать.
Texture2D shaderTexture : register(t0);
SamplerState SampleType : register(s0);

// PixelInputType для текстурированного пиксельного шейдера также модифицирован 
// с использованием координат текстуры вместо значений цвета.

//////////////
// TYPEDEFS //
//////////////
// ОПРЕДЕЛЕНИЯ ТИПОВ
struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
};

// Пиксельный шейдер был изменен так, что теперь он использует HLSL функцию sample. 
// Функция sample использует состояние сэмплера, которое мы определили выше, 
// и координаты текстуры для этого пикселя. 
// Она использует эти две переменные для определения и возврата значения пикселя 
// для этого UV расположения на грани полигона.

////////////////////////////////////////////////////////////////////////////////
// Pixel Shader
////////////////////////////////////////////////////////////////////////////////
// Пиксельный Шейдер
float4 TexturePixelShader(PixelInputType input) : SV_TARGET
{
    float4 textureColor;


    // Сэмплируем (берем образец) цвета пикселя из текстуры, используя сэмплер 
    // в этом расположении координат текстуры.
    textureColor = shaderTexture.Sample(SampleType, input.tex);

    return textureColor;
}