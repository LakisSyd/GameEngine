////////////////////////////////////////////////////////////////////////////////
// Filename: clipplane.vs
////////////////////////////////////////////////////////////////////////////////

/////////////
// GLOBALS //
/////////////
cbuffer MatrixBuffer
{
    matrix worldMatrix;
    matrix viewMatrix;
    matrix projectionMatrix;
};

// ћы используем 4-компонентный вектор (float4) дл€ плоскости отсечени€, чтобы внешние объекты 
// могли задать местоположение плоскости и указать, кака€ сторона будет отсекаетс€. 
// ѕервые три float задают нормаль плоскости (направление), а четвертый float указывает смещение (рассто€ние от начала координат).
// Ќапример, если вектор равен (0.0f, 1.0f, 0.0f, -5.0f), это означает, что будет отсекаетс€ всЄ, 
// что находитс€ ниже оси Y, и отсечение начнетс€ на высоте 5.0. 
// “аким образом, любой пиксель в сцене, у которого значение по оси Y меньше 5.0, никогда не будет нарисован.
// ¬ этом уроке мы будем использовать значение (0.0f, -1.0f, 0.0f, 0.0f), 
// что означает, что всЄ, что находитс€ выше 0.0 по оси Y, будет отбраковано.

cbuffer ClipPlaneBuffer
{
    float4 clipPlane;
};

//////////////
// TYPEDEFS //
//////////////
struct VertexInputType
{
    float4 position : POSITION;
    float2 tex : TEXCOORD0;
};

struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
    
    // ¬от семантика плоскости отсечени€, котора€ необходима в качестве входных данных дл€ пиксельного шейдера.
    float clip : SV_ClipDistance0;
};

////////////////////////////////////////////////////////////////////////////////
// Vertex Shader
////////////////////////////////////////////////////////////////////////////////
PixelInputType ClipPlaneVertexShader(VertexInputType input)
{
    PixelInputType output;

    // »змен€ем компонент w вектора позиции в 1.0f дл€ корректных матричных вычислений.
    input.position.w = 1.0f;

    // ¬ычисл€ем позицию вершины относительно матриц мира, вида и проекции.
    output.position = mul(input.position, worldMatrix);
    output.position = mul(output.position, viewMatrix);
    output.position = mul(output.position, projectionMatrix);

    // —охран€ем координаты текстуры дл€ передачи в пиксельный шейдер.
    output.tex = input.tex;

    // „тобы настроить плоскость отсечени€ дл€ входа в пиксельный шейдер, 
    // мы вычисл€ем скал€рное произведение (dot product) входной вершины в мировом пространстве 
    // на вектор плоскости отсечени€. “еперь плоскость отсечени€ активна, 
    // и пиксельный шейдер не будет отрисовывать ничего, что отсекаетс€ этой плоскостью.
    
    // ”станавливаем значение дл€ отсечени€.
    output.clip = dot(mul(input.position, worldMatrix), clipPlane);

    return output;
}