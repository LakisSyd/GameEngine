////////////////////////////////////////////////////////////////////////////////
// Filename: texture.vs
////////////////////////////////////////////////////////////////////////////////


/////////////
// GLOBALS //
/////////////
// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ
cbuffer MatrixBuffer
{
    matrix worldMatrix;
    matrix viewMatrix;
    matrix projectionMatrix;
};
// Мы больше не используем цвет в нашем типе вершины и вместо этого перешли на использование координат текстуры.
// Поскольку координаты текстуры принимают float координаты U и V, мы используем float2 как их тип.
// Семантика для координат текстуры — TEXCOORD0 для вершинных и пиксельных шейдеров.
// Вы можете изменить ноль на любое число, чтобы указать, с каким набором координат вы работаете,
// так как допускается несколько наборов координат текстуры.

//////////////
// TYPEDEFS //
//////////////
// ОПРЕДЕЛЕНИЯ ТИПОВ
struct VertexInputType
{
    float4 position : POSITION;
    float2 tex : TEXCOORD0;
};

struct PixelInputType
{
    float4 position : SV_POSITION;
    float2 tex : TEXCOORD0;
};


////////////////////////////////////////////////////////////////////////////////
// Vertex Shader
////////////////////////////////////////////////////////////////////////////////
// Вершинный Шейдер
PixelInputType TextureVertexShader(VertexInputType input)
{
    PixelInputType output;
    

    // Изменяем вектор позиции на 4 единицы для правильных вычислений матрицы.
    input.position.w = 1.0f;

    // Вычисляем позицию вершины относительно матриц мира, вида и проекции.
    output.position = mul(input.position, worldMatrix);
    output.position = mul(output.position, viewMatrix);
    output.position = mul(output.position, projectionMatrix);

    // Единственное отличие текстурированного вершинного шейдера по сравнению с цветовым вершинным шейдером 
    // из предыдущего урока заключается в том, что вместо копирования цвета из входной вершины 
    // мы копируем координаты текстуры и передаем их в пиксельный шейдер.

    // Сохраняем координаты текстуры для пиксельного шейдера.
    output.tex = input.tex;

    return output;
}