// ============================================================
// pbr.ps — Пиксельный шейдер PBR (Cook-Torrance BRDF)
// ============================================================
#define NUM_LIGHTS 4
#define PI 3.14159265359f

Texture2D albedoMap    : register(t0);
Texture2D normalMap    : register(t1);
Texture2D metalnessMap : register(t2);
Texture2D roughnessMap : register(t3);
Texture2D crackMap : register(t6); // маска трещины: R=mask, G=roughness offset
TextureCube environmentMap : register(t8); // skybox cubemap для простого specular environment

// ── Буфер повреждений (decal трещин) — слот b7 ───────────────────────────────
cbuffer DamageBuffer : register(b7)
{
    // xyz = позиция трещины в world space, w = радиус
    float4 crackPositions[8];
    // x = intensity (0=нет, 1=max), y = rotation, zw = pad
    float4 crackParams[8];
    int    crackCount;
    float3 _damPad;
};
// Shadow map
Texture2D shadowMap : register(t7);
SamplerComparisonState shadowSampler : register(s7);

SamplerState SampleType : register(s0);

cbuffer LightColorBuffer : register(b0)
{
    float4 diffuseColor[NUM_LIGHTS];
};

cbuffer LightPositionBuffer : register(b1)
{
    float4 lightPosition[NUM_LIGHTS];
};

#include "src/Render/Shader/Vs/fog_common.hlsli"

cbuffer SelectedBuffer : register(b3)
{
    float selectedFactor;
    float3 selectedPadding;
};

cbuffer DirectionalLightBuffer : register(b4)
{
    float4 dirLightDirection;
    float4 dirLightColor;
    float4 dirLightAmbient;
};

cbuffer ShadowBuffer : register(b5)
{
    matrix lightViewProj;
};

cbuffer PBRParamsBuffer : register(b6)
{
    float3 cameraPos;
    float  glassOpacity;   // 0 = стекло полностью прозрачное, 1 = непрозрачное (было: padding)
};

struct PixelInputType
{
    float4 position              : SV_POSITION;
    float2 tex                   : TEXCOORD0;
    float3 normal                : NORMAL;
    float3 tangent               : TANGENT;
    float3 binormal              : BINORMAL;
    float3 worldPos              : TEXCOORD5;
    float3 lightVec[NUM_LIGHTS]  : TEXCOORD6;
    float  fogFactor             : FOG;
    bool   isFrontFace           : SV_IsFrontFace;
};

// ════════════════════════════════════════════════════════════
// РАСЧЁТ ТЕНЕЙ
// ════════════════════════════════════════════════════════════
float CalculateShadow(float3 worldPos)
{
    float4 lightSpacePos = mul(float4(worldPos, 1.0f), lightViewProj);
    lightSpacePos.xyz /= lightSpacePos.w;

    float2 shadowUV;
    shadowUV.x =  lightSpacePos.x * 0.5f + 0.5f;
    shadowUV.y = -lightSpacePos.y * 0.5f + 0.5f;

    if (shadowUV.x < 0.0f || shadowUV.x > 1.0f ||
        shadowUV.y < 0.0f || shadowUV.y > 1.0f)
        return 1.0f;

    float currentDepth = lightSpacePos.z;
    if (currentDepth > 1.0f) return 1.0f;

    float shadow = 0.0f;
    float texelSize = 1.0f / 2048.0f;
    float bias = 0.01f;

    [unroll]
    for (int x = -1; x <= 1; x++)
    {
        [unroll]
        for (int y = -1; y <= 1; y++)
        {
            float2 offset = float2(x, y) * texelSize;
            shadow += shadowMap.SampleCmp(shadowSampler,
                          shadowUV + offset, currentDepth - bias);
        }
    }
    return shadow / 9.0f;
}

// ════════════════════════════════════════════════════════════
// PBR функции (Cook-Torrance)
// ════════════════════════════════════════════════════════════
float DistributionGGX(float3 N, float3 H, float roughness)
{
    float a      = roughness * roughness;
    float a2     = a * a;
    float NdotH  = max(dot(N, H), 0.0f);
    float denom  = (NdotH * NdotH * (a2 - 1.0f) + 1.0f);
    return a2 / (PI * denom * denom);
}

float3 FresnelSchlick(float cosTheta, float3 F0)
{
    return F0 + (1.0f - F0) * pow(saturate(1.0f - cosTheta), 5.0f);
}

float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0f;
    float k = (r * r) / 8.0f;
    return NdotV / (NdotV * (1.0f - k) + k);
}

float GeometrySmith(float3 N, float3 V, float3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0f);
    float NdotL = max(dot(N, L), 0.0f);
    return GeometrySchlickGGX(NdotV, roughness)
         * GeometrySchlickGGX(NdotL, roughness);
}

float4 PBRPixelShader(PixelInputType input) : SV_TARGET
{
    float4 albedoSample = albedoMap.Sample(SampleType, input.tex);
    float3 albedo = albedoSample.rgb;
    // alpha из текстуры используем только для масок (не для стекла)
    float  texAlpha = albedoSample.a;

    float4 mrSample  = metalnessMap.Sample(SampleType, input.tex);
    float4 roughSample = roughnessMap.Sample(SampleType, input.tex);
    float  metalness = mrSample.b;

    // ════════════════════════════════════════════════════════
    // ОПРЕДЕЛЯЕМ СТЕКЛО по glassOpacity из константного буфера:
    //   glassOpacity = 0.0  → стекло (прозрачный материал)
    //   glassOpacity = 1.0  → обычный непрозрачный PBR
    // glassOpacity задаётся из MaterialClass::SetGlass(true, opacity)
    // ════════════════════════════════════════════════════════
    bool  isGlass   = (glassOpacity < 0.99f);
    float baseAlpha = isGlass ? glassOpacity : texAlpha;

    // Roughness: для стекла принудительно очень низкий (0.02-0.05)
    // glTF usually stores roughness in the G channel of the metallic-roughness map.
    // When Assimp exposes roughness as a separate grayscale texture, all channels are equal,
    // so reading G still works and keeps the convention consistent.
    float rawRoughness = roughSample.g;
    float roughness;
    if (isGlass)
    {
        // Если нет roughness текстуры (fallback = белый = 1.0), форсируем 0.02
        // Иначе клампим до максимума 0.05 для чистого стекла
        roughness = (rawRoughness > 0.5f) ? 0.02f : min(rawRoughness, 0.05f);
    }
    else
    {
        roughness = max(rawRoughness, 0.04f);
    }

    float3 N = normalize(input.normal);

    float3 ns = normalMap.Sample(SampleType, input.tex).xyz;
    if (length(ns - float3(0.5f, 0.5f, 1.0f)) > 0.05f)
    {
        ns = ns * 2.0f - 1.0f;
        float3 T = normalize(input.tangent);
        float3 B = normalize(input.binormal);
        float3x3 TBN = float3x3(T, B, N);
        N = normalize(mul(ns, TBN));
    }

    float3 V = normalize(cameraPos - input.worldPos);
    if (!input.isFrontFace) N = -N;

    // F0: стекло = диэлектрик IOR~1.5 → F0 = 0.04
    float3 F0 = lerp(float3(0.04f, 0.04f, 0.04f), albedo, metalness);

    float shadowFactor = CalculateShadow(input.worldPos);
    float3 Lo = float3(0.0f, 0.0f, 0.0f);

    // ── Направленный свет ──────────────────────────────────────────────────
    {
        float3 L = normalize(-dirLightDirection.xyz);
        float3 H = normalize(V + L);
        float NdotL = saturate(dot(N, L));
        if (NdotL > 0.0f)
        {
            float  NDF = DistributionGGX(N, H, roughness);
            float  G   = GeometrySmith(N, V, L, roughness);
            float3 F   = FresnelSchlick(saturate(dot(H, V)), F0);
            float3 numerator   = NDF * G * F;
            float  denominator = 4.0f * max(dot(N, V), 0.001f) * NdotL;
            float3 specular    = numerator / max(denominator, 0.001f);
            float3 kD = (1.0f - F) * (1.0f - metalness);
            // Стекло: диффуз масштабируем по прозрачности
            if (isGlass) kD *= baseAlpha;
            float3 radiance = dirLightColor.rgb * dirLightDirection.w;
            Lo += (kD * albedo / PI + specular) * radiance * NdotL * shadowFactor;
        }
    }

    // ── Точечные источники света ──────────────────────────────────────────
    for (int i = 0; i < NUM_LIGHTS; i++)
    {
        if (diffuseColor[i].w < 0.001f) continue;
        float3 L = normalize(input.lightVec[i]);
        float3 H = normalize(V + L);
        float NdotL = saturate(dot(N, L));
        if (NdotL > 0.0f)
        {
            float  NDF = DistributionGGX(N, H, roughness);
            float  G   = GeometrySmith(N, V, L, roughness);
            float3 F   = FresnelSchlick(saturate(dot(H, V)), F0);
            float3 numerator   = NDF * G * F;
            float  denominator = 4.0f * max(dot(N, V), 0.001f) * NdotL;
            float3 specular    = numerator / max(denominator, 0.001f);
            float3 kD = (1.0f - F) * (1.0f - metalness);
            if (isGlass) kD *= baseAlpha;
            float3 radiance = diffuseColor[i].rgb * diffuseColor[i].w;
            Lo += (kD * albedo / PI + specular) * radiance * NdotL;
        }
    }

    // ── Ambient ──────────────────────────────────────────────────────────────
    float3 ambientLight = dirLightAmbient.rgb * max(dirLightAmbient.w, 0.0f);
    if (dot(ambientLight, float3(1,1,1)) < 0.001f)
        ambientLight = float3(0.15f, 0.15f, 0.15f);

    float NdotV = max(dot(N, V), 0.0f);
    float3 F_ambient = FresnelSchlick(NdotV, F0);
    float3 kD_ambient = (1.0f - F_ambient) * (1.0f - metalness);

    // Диффузный ambient: для стекла подавляем (оно прозрачное — почти не рассеивает)
    float3 ambient_diffuse = kD_ambient * albedo * ambientLight
                           * (isGlass ? (baseAlpha * baseAlpha) : 1.0f);

    // Зеркальный ambient: Fresnel-отражение (для стекла — это и есть его главный эффект)
    float3 specularTint     = lerp(float3(1.0f, 1.0f, 1.0f), albedo, metalness);
    float  roughnessBias    = roughness * roughness;
    float3 R = reflect(-V, N);
    float3 envReflection = environmentMap.Sample(SampleType, R).rgb;
    float  envSpecStrength = saturate(1.0f - roughnessBias) * 0.65f;

    float3 ambient_specular = F_ambient * specularTint *
        (ambientLight * lerp(1.0f, 0.1f, roughnessBias) + envReflection * envSpecStrength);

    float3 ambient = ambient_diffuse + ambient_specular;
    float3 color   = ambient + Lo;

    // ── Tone mapping + Gamma ─────────────────────────────────────────────────
    color = (color * (2.51f * color + 0.03f)) / (color * (2.43f * color + 0.59f) + 0.14f);
    color = pow(saturate(color), 1.0f / 2.2f);

    // ════════════════════════════════════════════════════════
    // ФИНАЛЬНАЯ ПРОЗРАЧНОСТЬ
    // ════════════════════════════════════════════════════════
    float finalAlpha;
    if (isGlass)
    {
        // Fresnel-эффект: края стекла более непрозрачны (реалистичный эффект)
        float fresnelEdge = pow(saturate(1.0f - NdotV), 4.0f);
        // Основа: baseAlpha (0.1-0.3 для чистого стекла)
        // + усиление на краях через Fresnel
        finalAlpha = saturate(baseAlpha + fresnelEdge * 0.5f);

        // Лёгкий tint стекла цветом albedo только если albedo не нейтральный
        float albedoLum = dot(albedo, float3(0.299f, 0.587f, 0.114f));
        float tintStrength = saturate(1.0f - albedoLum) * 0.4f;
        color = lerp(color, color * albedo, tintStrength);
    }
    else
    {
        finalAlpha = texAlpha;
    }


      // ════════════════════════════════════════════════════════
    // ТРЕЩИНЫ — накладываем crack decal поверх albedo
    // Для каждой трещины: если worldPos близко к crackPosition →
    // смешиваем crack-текстуру, темним albedo, повышаем roughness
    // ════════════════════════════════════════════════════════
    float totalCrackMask = 0.0f;

    [unroll]
    for (int ci = 0; ci < crackCount && ci < 8; ci++)
    {
        float3 crackWorldPos = crackPositions[ci].xyz;
        float  crackRadius   = crackPositions[ci].w;
        float  crackIntensity = crackParams[ci].x;
        float  crackRotation  = crackParams[ci].y;

        if (crackIntensity < 0.001f) continue;

        // Расстояние от пикселя до центра трещины
        float dist = length(input.worldPos - crackWorldPos);

        // Нормализованное расстояние [0=центр, 1=граница]
        float normDist = saturate(dist / max(crackRadius, 0.001f));

        // Плавный переход от центра к краю (1 = в центре, 0 = снаружи)
        float falloff = saturate(1.0f - normDist * normDist);

        if (falloff < 0.001f) continue;

        // UV для crack-текстуры: проецируем worldPos на плоскость нормали
        // Используем XZ проекцию с поворотом
        float2 crackUV;
        float  sinR = sin(crackRotation);
        float  cosR = cos(crackRotation);
        float2 planarXZ = float2(input.worldPos.x - crackWorldPos.x,
                                 input.worldPos.z - crackWorldPos.z);
        crackUV.x = (planarXZ.x * cosR - planarXZ.y * sinR) / crackRadius * 0.5f + 0.5f;
        crackUV.y = (planarXZ.x * sinR + planarXZ.y * cosR) / crackRadius * 0.5f + 0.5f;

        float4 crackSample = crackMap.Sample(SampleType, crackUV);
        float  crackMask   = crackSample.r * falloff * crackIntensity;

        totalCrackMask = saturate(totalCrackMask + crackMask);
    }

    // Применяем трещину: темним albedo, повышаем roughness, добавляем синеватый "мокрый" оттенок
    if (totalCrackMask > 0.001f)
    {
        float3 crackColor = float3(0.04f, 0.04f, 0.06f); // тёмно-синий (мокрый металл)
        color    = lerp(color, color * crackColor, totalCrackMask * 0.85f);
        // roughness уже посчитан выше — визуально он уже в Lo/ambient
        // просто ещё добавляем тёмный ореол
    }


    float4 finalColor = float4(color, finalAlpha);

    // ── Выделение объекта в редакторе ────────────────────────────────────────
    if (selectedFactor > 1.5f)
    {
        float edge = 0.5f - saturate(dot(N, float3(0, 0, 1)));
        finalColor.rgb = lerp(finalColor.rgb, float3(0.0f, 0.85f, 0.3f), edge * 0.7f);
    }
    else
    {
        finalColor.rgb *= selectedFactor;
    }

    return ApplyFog(finalColor, input.fogFactor);
}