struct PixelInput
{
    float4 position : SV_POSITION;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
    float2 parameters : TEXCOORD1;
};

Texture2D particleTexture : register(t0);
SamplerState particleSampler : register(s0);

float Hash(float2 value)
{
    return frac(sin(dot(value, float2(127.1f, 311.7f))) * 43758.5453f);
}

float ValueNoise(float2 value)
{
    float2 cell = floor(value);
    float2 local = frac(value);
    local = local * local * (3.0f - 2.0f * local);

    float a = Hash(cell);
    float b = Hash(cell + float2(1.0f, 0.0f));
    float c = Hash(cell + float2(0.0f, 1.0f));
    float d = Hash(cell + float2(1.0f, 1.0f));
    return lerp(lerp(a, b, local.x), lerp(c, d, local.x), local.y);
}

float4 ParticlePixelShader(PixelInput input) : SV_TARGET
{
    const float age = saturate(input.parameters.x);
    const int shape = (int)(input.parameters.y + 0.5f);
    const float2 centered = input.uv * 2.0f - 1.0f;
    const float radius = length(centered);
    float alpha = 0.0f;
    float3 color = input.color.rgb;

    if (shape == 5) // Authored texture or one frame of a sprite sheet
    {
        const float4 sampled = particleTexture.Sample(particleSampler, input.uv);
        color *= sampled.rgb;
        alpha = sampled.a;
    }
    else if (shape == 1) // Flame
    {
        const float width = lerp(0.25f, 0.82f, input.uv.y);
        const float2 flamePoint = float2(centered.x / width, (input.uv.y - 0.56f) * 1.75f);
        const float flicker = ValueNoise(input.uv * 5.0f + float2(age * 8.0f, -age * 13.0f));
        alpha = 1.0f - smoothstep(0.48f + flicker * 0.08f, 1.0f, length(flamePoint));
        color *= lerp(1.35f, 0.82f, input.uv.y);
    }
    else if (shape == 2) // Smoke
    {
        const float noiseA = ValueNoise(input.uv * 4.5f + age * float2(1.1f, -2.0f));
        const float noiseB = ValueNoise(input.uv * 9.0f - age * float2(0.7f, 1.3f));
        const float distortedRadius = radius + (noiseA - 0.5f) * 0.24f;
        alpha = 1.0f - smoothstep(0.45f, 1.0f, distortedRadius);
        alpha *= lerp(0.62f, 1.0f, noiseB);
        color *= lerp(0.72f, 1.15f, noiseA);
    }
    else if (shape == 3) // Spark
    {
        const float2 streak = float2(centered.x * 3.7f, centered.y);
        alpha = 1.0f - smoothstep(0.18f, 1.0f, length(streak));
        color *= 1.7f;
    }
    else if (shape == 4) // Shockwave
    {
        const float ring = abs(radius - 0.72f);
        alpha = 1.0f - smoothstep(0.025f, 0.16f, ring);
        alpha *= 1.0f - smoothstep(0.82f, 1.0f, radius);
        color *= 1.4f;
    }
    else // SoftDisc
    {
        alpha = 1.0f - smoothstep(0.08f, 1.0f, radius);
    }

    const float fadeIn = saturate(age * 12.0f + 0.18f);
    const float fadeOut = saturate((1.0f - age) * 4.0f);
    alpha *= input.color.a * fadeIn * fadeOut;
    clip(alpha - 0.002f);
    return float4(color, alpha);
}
