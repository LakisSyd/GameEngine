Texture2D grassTexture : register(t0);
Texture2D dirtTexture  : register(t1);
Texture2D dirtMask     : register(t2);
Texture2D grassNormalMap : register(t3);
Texture2D dirtNormalMap  : register(t4);
Texture2D grassVariationTexture : register(t5);
Texture2D grassVariationNormalMap : register(t6);
Texture2D shadowMap    : register(t7);
SamplerState SampleType : register(s0);
SamplerComparisonState shadowSampler : register(s7);

cbuffer TerrainBuffer : register(b0)
{
    float2 terrainMinXZ;
    float2 terrainSizeXZ;
    float  tileScale;
    float  normalStrength;
    float  variationScale;
    float  variationStrength;
    float  brightness;
    float  ambientBoost;
    float2 padding;
};

cbuffer ShadowBuffer : register(b5)
{
    matrix lightViewProj;
};

cbuffer DirectionalLightBuffer : register(b4)
{
    float4 dirLightDirection;
    float4 dirLightColor;
    float4 dirLightAmbient;
};

struct PixelInputType
{
    float4 position : SV_POSITION;
    float3 worldPos : TEXCOORD0;
    float2 maskUV   : TEXCOORD1;
    float3 tangent  : TEXCOORD2;
    float3 binormal : TEXCOORD3;
    float3 normal   : NORMAL;
};

float CalculateShadow(float3 worldPos)
{
    float4 lightSpacePos = mul(float4(worldPos, 1.0f), lightViewProj);
    lightSpacePos.xyz /= lightSpacePos.w;

    float2 shadowUV;
    shadowUV.x = lightSpacePos.x * 0.5f + 0.5f;
    shadowUV.y = -lightSpacePos.y * 0.5f + 0.5f;

    if (shadowUV.x < 0.0f || shadowUV.x > 1.0f ||
        shadowUV.y < 0.0f || shadowUV.y > 1.0f)
        return 1.0f;

    float currentDepth = lightSpacePos.z;
    if (currentDepth > 1.0f)
        return 1.0f;

    float shadow = 0.0f;
    float texelSize = 1.0f / 2048.0f;
    float bias = 0.006f;

    [unroll]
    for (int x = -1; x <= 1; ++x)
    {
        [unroll]
        for (int y = -1; y <= 1; ++y)
        {
            float2 offset = float2(x, y) * texelSize;
            shadow += shadowMap.SampleCmp(shadowSampler, shadowUV + offset, currentDepth - bias);
        }
    }

    return shadow / 9.0f;
}

float Hash21(float2 p)
{
    p = frac(p * float2(123.34f, 456.21f));
    p += dot(p, p + 45.32f);
    return frac(p.x * p.y);
}

float ValueNoise(float2 uv)
{
    float2 i = floor(uv);
    float2 f = frac(uv);
    f = f * f * (3.0f - 2.0f * f);

    float a = Hash21(i);
    float b = Hash21(i + float2(1.0f, 0.0f));
    float c = Hash21(i + float2(0.0f, 1.0f));
    float d = Hash21(i + float2(1.0f, 1.0f));

    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float FbmNoise(float2 uv)
{
    float value = 0.0f;
    float amplitude = 0.5f;

    [unroll]
    for (int i = 0; i < 4; ++i)
    {
        value += ValueNoise(uv) * amplitude;
        uv *= 2.03f;
        amplitude *= 0.5f;
    }

    return saturate(value);
}

float4 TerrainBlendPixelShader(PixelInputType input) : SV_TARGET
{
    float2 tileUV = input.worldPos.xz * tileScale;
    float2 maskUV = saturate(input.maskUV);

    float mask = dirtMask.Sample(SampleType, maskUV).r;

    float variationMask = FbmNoise(input.worldPos.xz * max(variationScale, 0.0001f));
    variationMask = saturate((variationMask - 0.5f) * max(variationStrength, 0.0f) + 0.5f);

    float3 grassA = grassTexture.Sample(SampleType, tileUV).rgb;
    float3 grassB = grassVariationTexture.Sample(SampleType, tileUV).rgb;
    float3 grass = lerp(grassA, grassB, variationMask);
    float3 dirt = dirtTexture.Sample(SampleType, tileUV).rgb;
    float3 albedo = lerp(grass, dirt, saturate(mask)) * max(brightness, 0.0f);

    float3 baseNormal = normalize(input.normal);
    float3 tangent = normalize(input.tangent - baseNormal * dot(baseNormal, input.tangent));
    float3 binormal = normalize(input.binormal);
    float3x3 tbn = float3x3(tangent, binormal, baseNormal);

    float3 grassNormalA = grassNormalMap.Sample(SampleType, tileUV).xyz * 2.0f - 1.0f;
    float3 grassNormalB = grassVariationNormalMap.Sample(SampleType, tileUV).xyz * 2.0f - 1.0f;
    float3 grassNormal = normalize(lerp(grassNormalA, grassNormalB, variationMask));
    float3 dirtNormal = dirtNormalMap.Sample(SampleType, tileUV).xyz * 2.0f - 1.0f;
    float3 tangentNormal = normalize(lerp(grassNormal, dirtNormal, saturate(mask)));
    tangentNormal.xy *= normalStrength;
    tangentNormal = normalize(tangentNormal);
    float3 normal = normalize(mul(tangentNormal, tbn));

    float3 lightDir = normalize(-dirLightDirection.xyz);
    float ndotl = saturate(dot(normal, lightDir));
    float3 direct = dirLightColor.rgb * max(dirLightDirection.w, 0.0f) * ndotl;
    float3 ambient = dirLightAmbient.rgb * max(dirLightAmbient.w, 0.0f) * max(ambientBoost, 0.0f);
    float shadow = CalculateShadow(input.worldPos);
    float3 lit = albedo * (ambient + direct * shadow);
    return float4(saturate(lit), 1.0f);
}
