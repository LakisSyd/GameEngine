//////////////
// ОПРЕДЕЛЕНИЯ ТИПОВ
//////////////

struct PixelInputType
{
    float4 position : SV_POSITION;
    float4 color : COLOR;
};

////////////////////////////////////////////////////////////////////////////////
// ПИКСЕЛЬНЫЙ ШЕЙДЕР
////////////////////////////////////////////////////////////////////////////////

// Пиксельный шейдер принимает данные от вершинного шейдера и возвращает конечный цвет пикселя.
// В этом простом примере мы просто возвращаем интерполированный цвет вершины.
float4 ColorPixelShader(PixelInputType input) : SV_TARGET
{
    return input.color;
}