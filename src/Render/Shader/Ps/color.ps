// color.ps — ПИКСЕЛЬНЫЙ ШЕЙДЕР

//////////////
// КОНСТАНТНЫЕ БУФЕРЫ
//////////////
cbuffer ColorBuffer : register(b0)
{
    float4 uniformColor;
    float3 padding; // Выравнивание, не используется
};

//////////////
// ТИПЫ ДАННЫХ
//////////////
struct PixelInputType
{
    float4 position : SV_POSITION;
    float4 color : COLOR;
};

////////////////////////////////////////////////////////////////////////////////
// ПИКСЕЛЬНЫЙ ШЕЙДЕР
////////////////////////////////////////////////////////////////////////////////
float4 ColorPixelShader(PixelInputType input) : SV_TARGET
{
    // Возвращаем uniform цвет (игнорируем вершинный цвет)
   return uniformColor;
}